# Copia este archivo a .env y ajusta los valores antes de iniciar el servidor.

# Puerto en el que escucha la aplicación (Nginx hará proxy_pass hacia este puerto)
PORT=3000

# Entorno: development | production
NODE_ENV=production

# Clave secreta para firmar las cookies de sesión. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Nombre público del sitio (usado como valor por defecto del CMS la primera vez)
SITE_NAME=Moquegua Soft

# Ruta del archivo SQLite (relativa a server/)
DB_FILE=data/moqueguasoft.db
