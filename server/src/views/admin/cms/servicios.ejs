<%- include('../partials/head') %>
<%- include('../partials/shell-start') %>

<div class="table-card mb-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Ícono</th><th>Título</th><th>Descripción</th><th>Orden</th><th>Activo</th><th></th></tr></thead>
            <tbody>
                <% services.forEach(s => { const fid = `svc-form-${s.id}`; %>
                <tr>
                    <td style="width:60px;"><i class="<%= s.icon %> fs-4 text-primary"></i></td>
                    <td style="min-width:160px;"><input form="<%= fid %>" type="text" name="title" class="form-control form-control-sm" value="<%= s.title %>"></td>
                    <td><input form="<%= fid %>" type="text" name="description" class="form-control form-control-sm" value="<%= s.description %>"></td>
                    <td style="width:80px;"><input form="<%= fid %>" type="number" name="sort_order" class="form-control form-control-sm" value="<%= s.sort_order %>"></td>
                    <td style="width:70px;"><input form="<%= fid %>" type="checkbox" name="active" class="form-check-input" <%= s.active ? 'checked' : '' %>></td>
                    <td class="text-end" style="white-space:nowrap;">
                        <form id="<%= fid %>" method="POST" action="/admin/cms/servicios/<%= s.id %>" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        </form>
                        <button form="<%= fid %>" class="btn btn-sm btn-ms-primary">Guardar</button>
                        <button form="<%= fid %>" class="btn btn-sm btn-outline-danger" formaction="/admin/cms/servicios/<%= s.id %>/eliminar" onclick="return confirm('¿Eliminar este servicio?');">Eliminar</button>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <p class="text-muted small mb-0">El ícono usa clases de Font Awesome, por ejemplo: <code>fas fa-laptop-code</code>.</p>
</div>

<div class="table-card" style="max-width:520px;">
    <h6 class="mb-3">Agregar servicio</h6>
    <form method="POST" action="/admin/cms/servicios/nuevo">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-2"><input type="text" name="title" class="form-control form-control-sm" placeholder="Título" required></div>
        <div class="mb-2"><input type="text" name="description" class="form-control form-control-sm" placeholder="Descripción"></div>
        <div class="mb-2"><input type="text" name="icon" class="form-control form-control-sm" placeholder="fas fa-laptop-code"></div>
        <div class="mb-2"><input type="number" name="sort_order" class="form-control form-control-sm" placeholder="Orden" value="0"></div>
        <button class="btn btn-sm btn-ms-primary">Agregar</button>
    </form>
</div>

<%- include('../partials/shell-end') %>
