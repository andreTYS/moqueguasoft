<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>Iniciar sesión · Panel Moquegua Soft</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/admin.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <div class="card shadow-sm border-0" style="width: 100%; max-width: 380px;">
        <div class="card-body p-4">
            <h4 class="mb-1 text-center">Moquegua<span style="color:#ffb800">Soft</span></h4>
            <p class="text-muted text-center mb-4">Panel de administración</p>
            <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
            <form method="POST" action="/admin/login">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label">Correo</label>
                    <input type="email" name="email" class="form-control" required autofocus>
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-ms-primary w-100">Ingresar</button>
            </form>
        </div>
    </div>
</body>
</html>
