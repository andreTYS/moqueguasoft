<%- include('../partials/head') %>
<%- include('../partials/shell-start') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted"><%= rows.length %> comprobante(s)</span>
    <a href="/admin/facturas/nueva" class="btn btn-ms-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nuevo comprobante</a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>N°</th><th>Fecha</th><th>Cliente</th><th>Concepto</th><th class="text-end">Monto</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                <% rows.forEach(r => { %>
                <tr>
                    <td><%= r.number %></td>
                    <td><%= r.issue_date %></td>
                    <td><%= r.client_name || '—' %></td>
                    <td><%= r.concept %></td>
                    <td class="text-end"><%= r.currency %> <%= r.amount.toFixed(2) %></td>
                    <td><span class="badge bg-secondary text-dark text-capitalize"><%= r.status %></span></td>
                    <td class="text-end">
                        <a href="/admin/facturas/<%= r.id %>/pdf" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                        <form action="/admin/facturas/<%= r.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este comprobante?');">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (!rows.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Aún no hay comprobantes emitidos.</td></tr><% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/shell-end') %>
