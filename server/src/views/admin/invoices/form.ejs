<%- include('../partials/head') %>
<%- include('../partials/shell-start') %>

<div class="table-card" style="max-width:640px;">
    <form method="POST" action="/admin/facturas/nueva">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="income_id" value="<%= prefill.income_id || '' %>">
        <div class="mb-3">
            <label class="form-label">Concepto *</label>
            <input type="text" name="concept" class="form-control" value="<%= prefill.concept || '' %>" required>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Cliente</label>
                <select name="client_id" class="form-select">
                    <option value="">— Sin cliente —</option>
                    <% clients.forEach(c => { %>
                    <option value="<%= c.id %>" <%= prefill.client_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Proyecto</label>
                <select name="project_id" class="form-select">
                    <option value="">— Sin proyecto —</option>
                    <% projects.forEach(p => { %>
                    <option value="<%= p.id %>" <%= prefill.project_id == p.id ? 'selected' : '' %>><%= p.name %></option>
                    <% }) %>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Monto *</label>
                <input type="number" step="0.01" name="amount" class="form-control" value="<%= prefill.amount || '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Moneda</label>
                <select name="currency" class="form-select">
                    <option value="PEN">PEN (S/)</option>
                    <option value="USD">USD ($)</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Fecha de emisión</label>
                <input type="date" name="issue_date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>">
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Estado</label>
            <select name="status" class="form-select">
                <option value="emitida">Emitida</option>
                <option value="pagada">Pagada</option>
                <option value="anulada">Anulada</option>
            </select>
        </div>
        <button class="btn btn-ms-primary">Generar comprobante</button>
        <a href="/admin/facturas" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>

<%- include('../partials/shell-end') %>
