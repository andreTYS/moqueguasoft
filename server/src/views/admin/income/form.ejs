<%- include('../partials/head') %>
<%- include('../partials/shell-start') %>

<div class="table-card" style="max-width:640px;">
    <form method="POST" action="<%= row.id ? `/admin/ingresos/${row.id}/editar` : '/admin/ingresos/nuevo' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
            <label class="form-label">Concepto *</label>
            <input type="text" name="concept" class="form-control" value="<%= row.concept || '' %>" required>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Cliente</label>
                <select name="client_id" class="form-select">
                    <option value="">— Sin cliente —</option>
                    <% clients.forEach(c => { %>
                    <option value="<%= c.id %>" <%= row.client_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Proyecto</label>
                <select name="project_id" class="form-select">
                    <option value="">— Sin proyecto —</option>
                    <% projects.forEach(p => { %>
                    <option value="<%= p.id %>" <%= row.project_id == p.id ? 'selected' : '' %>><%= p.name %></option>
                    <% }) %>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Monto *</label>
                <input type="number" step="0.01" name="amount" class="form-control" value="<%= row.amount || '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Moneda</label>
                <select name="currency" class="form-select">
                    <option value="PEN" <%= (row.currency || 'PEN') === 'PEN' ? 'selected' : '' %>>PEN (S/)</option>
                    <option value="USD" <%= row.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Método</label>
                <select name="method" class="form-select">
                    <% ['transferencia','efectivo','yape/plin','tarjeta','otro'].forEach(m => { %>
                    <option value="<%= m %>" <%= (row.method || 'transferencia') === m ? 'selected' : '' %>><%= m %></option>
                    <% }) %>
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input type="date" name="income_date" class="form-control" value="<%= row.income_date || new Date().toISOString().slice(0,10) %>">
        </div>
        <div class="mb-3">
            <label class="form-label">Notas</label>
            <textarea name="notes" class="form-control" rows="3"><%= row.notes || '' %></textarea>
        </div>
        <button class="btn btn-ms-primary">Guardar</button>
        <a href="/admin/ingresos" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>

<%- include('../partials/shell-end') %>
