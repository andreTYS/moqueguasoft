<%- include('../partials/head') %>
<%- include('../partials/shell-start') %>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted"><%= rows.length %> registro(s) · Total: S/ <%= total.toFixed(2) %></span>
    <a href="/admin/gastos/nuevo" class="btn btn-ms-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nuevo gasto</a>
</div>

<div class="table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Fecha</th><th>Categoría</th><th>Concepto</th><th class="text-end">Monto</th><th></th></tr></thead>
            <tbody>
                <% rows.forEach(r => { %>
                <tr>
                    <td><%= r.expense_date %></td>
                    <td class="text-capitalize"><%= r.category %></td>
                    <td><%= r.concept %></td>
                    <td class="text-end"><%= r.currency %> <%= r.amount.toFixed(2) %></td>
                    <td class="text-end">
                        <a href="/admin/gastos/<%= r.id %>/editar" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                        <form action="/admin/gastos/<%= r.id %>/eliminar" method="POST" class="d-inline" onsubmit="return confirm('¿Eliminar este gasto?');">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                <% }) %>
                <% if (!rows.length) { %><tr><td colspan="5" class="text-center text-muted py-4">Aún no hay gastos registrados.</td></tr><% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('../partials/shell-end') %>
