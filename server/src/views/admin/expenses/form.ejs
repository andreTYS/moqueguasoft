<%- include('../partials/head') %>
<%- include('../partials/shell-start') %>

<div class="table-card" style="max-width:560px;">
    <form method="POST" action="<%= row.id ? `/admin/gastos/${row.id}/editar` : '/admin/gastos/nuevo' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
            <label class="form-label">Concepto *</label>
            <input type="text" name="concept" class="form-control" value="<%= row.concept || '' %>" required>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Categoría</label>
                <select name="category" class="form-select">
                    <% ['general','hosting/dominio','software','marketing','personal','impuestos','otro'].forEach(c => { %>
                    <option value="<%= c %>" <%= (row.category || 'general') === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Monto *</label>
                <input type="number" step="0.01" name="amount" class="form-control" value="<%= row.amount || '' %>" required>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Moneda</label>
                <select name="currency" class="form-select">
                    <option value="PEN" <%= (row.currency || 'PEN') === 'PEN' ? 'selected' : '' %>>PEN (S/)</option>
                    <option value="USD" <%= row.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha</label>
                <input type="date" name="expense_date" class="form-control" value="<%= row.expense_date || new Date().toISOString().slice(0,10) %>">
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Notas</label>
            <textarea name="notes" class="form-control" rows="3"><%= row.notes || '' %></textarea>
        </div>
        <button class="btn btn-ms-primary">Guardar</button>
        <a href="/admin/gastos" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>

<%- include('../partials/shell-end') %>
