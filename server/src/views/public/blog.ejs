<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Blog' }) %>

<section class="section">
    <div class="container">
        <div class="blog-grid">
            <% posts.forEach((p, i) => { %>
            <div class="post-card">
                <div class="post-card__cover <%= media.isUploaded(p.image) ? '' : 'grad-' + ((i % 6) + 1) %>">
                    <% if (media.isUploaded(p.image)) { %><img src="<%= p.image %>" alt="<%= p.title %>"><% } %>
                    <i class="fas fa-newspaper"></i>
                </div>
                <div class="post-card__body">
                    <div class="post-card__meta">
                        <span><i class="fas fa-user"></i><%= p.author %></span>
                        <span><i class="fas fa-calendar-alt"></i><%= new Date(p.published_at).toLocaleDateString('es-PE') %></span>
                    </div>
                    <h3><a href="/blog/<%= p.slug %>" class="text-dark"><%= p.title %></a></h3>
                    <p><%= p.excerpt %></p>
                    <a href="/blog/<%= p.slug %>" class="post-card__link">Leer más <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
            <% }) %>
            <% if (!posts.length) { %>
            <p class="text-center">Aún no hay artículos publicados.</p>
            <% } %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
