<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Blog' }) %>

<div class="container-fluid py-5">
    <div class="container">
        <div class="row g-4">
            <% posts.forEach(p => { %>
            <div class="col-lg-4 col-md-6">
                <div class="blog-item">
                    <img src="<%= p.image %>" alt="<%= p.title %>">
                    <div class="blog-content">
                        <div class="blog-icon">
                            <small><i class="fas fa-user"></i> <%= p.author %></small>
                            <small><i class="fas fa-calendar-alt"></i> <%= new Date(p.published_at).toLocaleDateString('es-PE') %></small>
                        </div>
                        <h5><a href="/blog/<%= p.slug %>" class="text-dark"><%= p.title %></a></h5>
                        <p><%= p.excerpt %></p>
                        <a href="/blog/<%= p.slug %>" class="blog-btn">Leer más <i class="fas fa-arrow-right ms-1"></i></a>
                    </div>
                </div>
            </div>
            <% }) %>
            <% if (!posts.length) { %>
            <p class="text-center">Aún no hay artículos publicados.</p>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
