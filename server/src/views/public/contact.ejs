<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Contacto' }) %>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center mx-auto reveal">
            <div class="kicker" style="justify-content:center;">Contáctanos</div>
            <h2>Escríbenos sobre tu proyecto</h2>
            <p class="mt-3 mb-0"><%= content.intro %></p>
        </div>

        <div class="contact-grid mb-5 reveal">
            <div class="contact-card">
                <i class="fas fa-map-marker-alt"></i>
                <h3>Dirección</h3>
                <p><%= settings.address %></p>
            </div>
            <div class="contact-card">
                <i class="fas fa-phone"></i>
                <h3>Llámanos</h3>
                <p><%= settings.phone %></p>
            </div>
            <div class="contact-card">
                <i class="fas fa-envelope-open"></i>
                <h3>Escríbenos</h3>
                <p><%= settings.email %></p>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-6">
                <div class="map-frame">
                    <iframe src="<%= settings.map_embed %>" loading="lazy"></iframe>
                </div>
            </div>
            <div class="col-lg-6">
                <% if (sent) { %>
                <div class="alert alert-success">¡Gracias! Tu mensaje fue enviado correctamente, te responderemos pronto.</div>
                <% } %>
                <form class="form-modern" method="POST" action="/contacto">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="name" placeholder="Tu nombre" required>
                        </div>
                        <div class="col-md-6">
                            <input type="email" class="form-control" name="email" placeholder="Tu correo" required>
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="phone" placeholder="Teléfono (opcional)">
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="subject" placeholder="Asunto">
                        </div>
                        <div class="col-12">
                            <textarea class="form-control" rows="5" name="message" placeholder="Cuéntanos sobre tu proyecto" required></textarea>
                        </div>
                        <div class="col-12">
                            <button class="btn-pill btn-pill--solid w-100 justify-content-center" type="submit">Enviar mensaje <i class="fas fa-arrow-right"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
