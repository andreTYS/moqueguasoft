<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Contacto' }) %>

<div class="container-fluid py-5">
    <div class="container">
        <div class="text-center mx-auto mb-5" style="max-width: 600px;">
            <h6 class="text-secondary text-uppercase">Contáctanos</h6>
            <h1>Escríbenos sobre tu proyecto</h1>
            <p class="mt-3"><%= content.intro %></p>
        </div>
        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6">
                <div class="contact-detail text-center">
                    <i class="fas fa-map-marker-alt fa-2x mb-3"></i>
                    <h5>Dirección</h5>
                    <p class="mb-0"><%= settings.address %></p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="contact-detail text-center">
                    <i class="fas fa-phone fa-2x mb-3"></i>
                    <h5>Llámanos</h5>
                    <p class="mb-0"><%= settings.phone %></p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="contact-detail text-center">
                    <i class="fas fa-envelope-open fa-2x mb-3"></i>
                    <h5>Escríbenos</h5>
                    <p class="mb-0"><%= settings.email %></p>
                </div>
            </div>
        </div>
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="contact-map">
                    <iframe src="<%= settings.map_embed %>" loading="lazy"></iframe>
                </div>
            </div>
            <div class="col-lg-6">
                <% if (sent) { %>
                <div class="alert alert-success">¡Gracias! Tu mensaje fue enviado correctamente, te responderemos pronto.</div>
                <% } %>
                <form class="contact-form" method="POST" action="/contacto">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="name" placeholder="Tu nombre" required>
                        </div>
                        <div class="col-md-6">
                            <input type="email" class="form-control" name="email" placeholder="Tu correo" required>
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="phone" placeholder="Teléfono (opcional)">
                        </div>
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="subject" placeholder="Asunto">
                        </div>
                        <div class="col-12">
                            <textarea class="form-control" rows="5" name="message" placeholder="Cuéntanos sobre tu proyecto" required></textarea>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary w-100 py-3" type="submit">Enviar mensaje</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
