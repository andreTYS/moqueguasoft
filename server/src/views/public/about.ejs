<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Nosotros' }) %>

<section class="section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 reveal">
                <%- include('../partials/svg-about', { floatValue: '100% remoto', floatLabel: 'Trabajamos con negocios de todo el Perú' }) %>
            </div>
            <div class="col-lg-6 reveal reveal--2">
                <div class="kicker">Quiénes somos</div>
                <h2 class="mb-4" style="font-size:clamp(1.7rem,3vw,2.2rem); font-weight:700;"><%= content.intro_title %></h2>
                <p class="mb-4"><%= content.intro_body %></p>
                <p class="mb-0"><strong style="color:var(--ink)">Nuestra misión:</strong> <%= content.mission %></p>
            </div>
        </div>
    </div>
</section>

<section class="section section--alt">
    <div class="container">
        <div class="section-head section-head--center mx-auto reveal">
            <div class="kicker" style="justify-content:center;">Nuestro equipo</div>
            <h2>Personas detrás de Moquegua Soft</h2>
        </div>
        <div class="team-grid">
            <% team.forEach((t, i) => { %>
            <div class="team-card reveal reveal--<%= (i % 6) + 1 %>">
                <% if (media.isUploaded(t.photo)) { %>
                    <div class="avatar"><img src="<%= t.photo %>" alt="<%= t.name %>"></div>
                <% } else { %>
                    <div class="avatar" style="background:<%- media.gradientFor(t.name) %>"><%= media.initials(t.name) %></div>
                <% } %>
                <h3><%= t.name %></h3>
                <div class="role"><%= t.role %></div>
            </div>
            <% }) %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
