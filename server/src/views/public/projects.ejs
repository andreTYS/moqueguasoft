<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Proyectos' }) %>

<div class="container-fluid py-5">
    <div class="container">
        <div class="text-center mx-auto mb-5" style="max-width: 600px;">
            <h6 class="text-secondary text-uppercase">Portafolio</h6>
            <h1>Proyectos que hemos desarrollado</h1>
        </div>
        <div class="row g-4">
            <% projects.forEach(p => { %>
            <div class="col-lg-4 col-md-6">
                <div class="project-item">
                    <div class="project-img">
                        <img src="<%= p.image %>" class="img-fluid" alt="<%= p.title %>">
                    </div>
                    <div class="project-content">
                        <p class="text-secondary mb-1"><%= p.category %></p>
                        <h5><%= p.title %></h5>
                        <% if (p.description) { %><p class="text-white-50 small mb-0"><%= p.description %></p><% } %>
                    </div>
                </div>
            </div>
            <% }) %>
            <% if (!projects.length) { %>
            <p class="text-center">Aún no hay proyectos publicados.</p>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
