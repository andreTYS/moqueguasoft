<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-header', { pageHeaderTitle: 'Proyectos' }) %>

<section class="section">
    <div class="container">
        <div class="section-head section-head--center mx-auto reveal">
            <div class="kicker" style="justify-content:center;">Portafolio</div>
            <h2>Proyectos que hemos desarrollado</h2>
        </div>
        <div class="work-grid">
            <% projects.forEach((p, i) => { %>
            <div class="work-card reveal reveal--<%= (i % 6) + 1 %>">
                <div class="work-card__cover <%= media.isUploaded(p.image) ? '' : 'grad-' + ((i % 6) + 1) %>">
                    <% if (media.isUploaded(p.image)) { %><img src="<%= p.image %>" alt="<%= p.title %>"><% } else { %><img src="<%= media.stockForProject(p.category, i) %>" alt="<%= p.title %>" loading="lazy" onerror="this.remove()"><% } %>
                    <i class="fas fa-diagram-project"></i>
                    <span class="work-card__tag"><%= p.category %></span>
                </div>
                <div class="work-card__body">
                    <h3><%= p.title %></h3>
                    <% if (p.description) { %><p><%= p.description %></p><% } %>
                </div>
            </div>
            <% }) %>
            <% if (!projects.length) { %>
            <p class="text-center">Aún no hay proyectos publicados.</p>
            <% } %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
