<!-- Ilustración decorativa "Sobre nosotros" (SVG propio, sin fotos externas) -->
<div class="about__visual">
    <svg viewBox="0 0 440 480" class="about__illustration" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ilustración de un panel de gestión">
        <defs>
            <linearGradient id="aboutBg" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0a0e1f"/>
                <stop offset="100%" stop-color="#1c2547"/>
            </linearGradient>
            <linearGradient id="aboutBars" x1="0%" y1="100%" x2="0%" y2="0%">
                <stop offset="0%" stop-color="#ff5630"/>
                <stop offset="100%" stop-color="#ffb648"/>
            </linearGradient>
            <linearGradient id="aboutRing" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff5630"/>
                <stop offset="100%" stop-color="#6d5bd0"/>
            </linearGradient>
            <filter id="aboutBlur" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="26"/>
            </filter>
        </defs>

        <rect x="0" y="0" width="440" height="480" rx="24" fill="url(#aboutBg)"/>
        <circle cx="370" cy="60" r="90" fill="#ff5630" opacity=".35" filter="url(#aboutBlur)"/>
        <circle cx="50" cy="430" r="80" fill="#6d5bd0" opacity=".35" filter="url(#aboutBlur)"/>

        <!-- red de nodos conectados -->
        <g stroke="rgba(255,255,255,.18)" stroke-width="1.5">
            <line x1="60" y1="70" x2="140" y2="110"/>
            <line x1="140" y1="110" x2="120" y2="180"/>
            <line x1="140" y1="110" x2="220" y2="90"/>
        </g>
        <circle cx="60" cy="70" r="5" fill="#ffb648"/>
        <circle cx="140" cy="110" r="6" fill="#fff"/>
        <circle cx="120" cy="180" r="4" fill="#ff5630"/>
        <circle cx="220" cy="90" r="4" fill="#6d5bd0"/>

        <!-- ventana / panel principal -->
        <rect x="40" y="150" width="360" height="270" rx="18" fill="rgba(255,255,255,.06)" stroke="rgba(255,255,255,.14)"/>
        <circle cx="66" cy="176" r="5" fill="rgba(255,255,255,.35)"/>
        <circle cx="84" cy="176" r="5" fill="rgba(255,255,255,.35)"/>
        <circle cx="102" cy="176" r="5" fill="rgba(255,255,255,.35)"/>

        <!-- líneas de texto -->
        <rect x="64" y="204" width="150" height="8" rx="4" fill="rgba(255,255,255,.22)"/>
        <rect x="64" y="222" width="100" height="8" rx="4" fill="rgba(255,255,255,.14)"/>

        <!-- anillo de progreso -->
        <g transform="translate(320,215)">
            <circle r="42" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="10"/>
            <circle r="42" fill="none" stroke="url(#aboutRing)" stroke-width="10" stroke-linecap="round"
                    stroke-dasharray="210 264" transform="rotate(-90)"/>
            <text x="0" y="6" text-anchor="middle" fill="#fff" font-family="Space Grotesk, sans-serif" font-size="18" font-weight="700">80%</text>
        </g>

        <!-- barras -->
        <g>
            <rect x="64" y="330" width="26" height="60" rx="5" fill="url(#aboutBars)" opacity=".55"/>
            <rect x="102" y="300" width="26" height="90" rx="5" fill="url(#aboutBars)" opacity=".7"/>
            <rect x="140" y="270" width="26" height="120" rx="5" fill="url(#aboutBars)"/>
            <rect x="178" y="310" width="26" height="80" rx="5" fill="url(#aboutBars)" opacity=".7"/>
            <rect x="216" y="340" width="26" height="50" rx="5" fill="url(#aboutBars)" opacity=".5"/>
        </g>

        <!-- chip flotante -->
        <g transform="translate(272,300)">
            <rect width="108" height="66" rx="12" fill="rgba(255,255,255,.08)" stroke="rgba(255,255,255,.16)"/>
            <circle cx="22" cy="22" r="10" fill="#4ade80" opacity=".25"/>
            <path d="M17 22l4 4 8-9" stroke="#4ade80" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="14" y="42" width="80" height="7" rx="3.5" fill="rgba(255,255,255,.28)"/>
            <rect x="14" y="53" width="56" height="6" rx="3" fill="rgba(255,255,255,.16)"/>
        </g>
    </svg>

    <div class="about__card-float">
        <div class="value"><%= typeof floatValue !== 'undefined' ? floatValue : '6 años' %></div>
        <div class="label"><%= typeof floatLabel !== 'undefined' ? floatLabel : 'Construyendo software para negocios locales' %></div>
    </div>
</div>
